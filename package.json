{
  "name": "dsh-warm-theme",
  "version": "0.2.0",
  "description": "DSH 护眼配色包 —— 5 套低蓝光配色，通过官方 ctx.theme.overrideTokens 扩展点覆盖语义 token，零布局改动、热生效。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "icon.svg"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node test/smoke.mjs",
    "prepublishOnly": "node build.mjs && node test/smoke.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "theme-pack",
    "palette",
    "eye-care",
    "warm-color",
    "dark-mode"
  ],
  "license": "MIT",
  "author": "yrsxy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yrsxy/dsh-warm-theme.git"
  },
  "homepage": "https://github.com/yrsxy/dsh-warm-theme#readme",
  "bugs": {
    "url": "https://github.com/yrsxy/dsh-warm-theme/issues"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "external": [
        "@deepseek-ai/dsh-client-store"
      ],
      "inject": [
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
